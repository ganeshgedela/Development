Vagrant.configure("2") do |config|
  config.vm.define "tracenova" do |tracenova|
    # ✅ Base Image
    tracenova.vm.box = "ubuntu/jammy64"  # Ubuntu 22.04 LTS

    # ✅ VM Metadata
    tracenova.vm.hostname = "tracenova"

    # ✅ VM Resources and Provider Configuration
    tracenova.vm.provider "virtualbox" do |vb|
      vb.name = "tracenova-vm"       # Set VM name in VirtualBox GUI
      vb.memory = 4096               # 4 GB RAM
      vb.cpus = 2                    # 2 CPUs
      vb.gui = false                 # Set to true to show VirtualBox GUI (for debugging)
    end

    # ✅ Synced Folder (host to guest)
    tracenova.vm.synced_folder ".", "/home/vagrant/tracenova", type: "virtualbox"

    # ✅ Networking
    # tracenova.vm.network "forwarded_port", guest: 8080, host: 8080
    tracenova.vm.network "private_network", ip: "192.168.56.10"
  end
end

